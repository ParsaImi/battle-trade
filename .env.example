# Copy to .env on the server:  cp .env.example .env

# Ports the game is reachable on.
PUBLIC_PORT=80
TLS_PORT=443

# IMPORTANT: play over https://. Some networks (Iranian ISPs among them) let the
# WebSocket handshake through and then drop the plaintext frames, so the game
# connects and immediately goes dead over plain http. TLS fixes it.
#
# Name on the self-signed fallback certificate — your domain, or the public IP.
# Browsers warn on a self-signed cert; to get rid of the warning, point a domain
# here and drop a real fullchain.pem + privkey.pem into ./certs.
TLS_HOST=194.5.97.185

# Leave empty for the standard single-origin deploy: the client then opens its
# WebSocket at /ws on whatever host served the page.
VITE_WS_URL=

# CORS for the /health endpoint. The WebSocket does not use CORS.
ALLOWED_ORIGINS=*

# How long a player waits for a real opponent before being given an AI one.
MATCH_WAIT_MS=30000
