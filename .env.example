# Copy to .env on the server:  cp .env.example .env

# Ports the game is reachable on.
PUBLIC_PORT=80
TLS_PORT=443

# IMPORTANT: the game must be played over https://.
# Some networks (Iranian ISPs among them) let the WebSocket handshake through
# and then drop the plaintext frames, so over plain http the game connects and
# instantly goes dead — the connection dot stays red. TLS fixes it.
#
# Hostname the certificate is issued for. A bare IP cannot get a trusted
# certificate, so this uses sslip.io, which resolves any <ip>.sslip.io straight
# back to that IP and needs no registration. Replace with your own domain if
# you get one: point an A record at this box and change this line.
TLS_HOST=194-5-97-185.sslip.io

# Set to 1 once a trusted certificate has been issued (scripts/issue-cert.sh),
# so http:// visitors are redirected to the working https:// site.
FORCE_HTTPS=0

# Leave empty for the standard single-origin deploy: the client then opens its
# WebSocket at /ws on whatever host served the page.
VITE_WS_URL=

# CORS for the /health endpoint. The WebSocket does not use CORS.
ALLOWED_ORIGINS=*

# How long a player waits for a real opponent before being given an AI one.
MATCH_WAIT_MS=30000
