# Copy to .env on the server:  cp .env.example .env
# Public port the game is reachable on. 80 = plain http://<ip>/
PUBLIC_PORT=80

# Leave empty for the standard single-origin deploy: the client then opens
# its WebSocket at /ws on whatever host served the page.
# Only set this if the backend runs somewhere else, e.g. wss://api.example.com
VITE_WS_URL=

# CORS for the /health endpoint. The WebSocket does not use CORS.
ALLOWED_ORIGINS=*
